#define RT_MANIFEST 24
1 RT_MANIFEST "RustyClient.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Rusty Client"
      VALUE "ProductName", "Rusty Client"
      VALUE "InternalName", "RustyClient"
      VALUE "OriginalFilename", "RustyClient.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
